# Never commit a real .env file. Set the same values in Cloudflare's secret manager.
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Use sslmode=require for managed PostgreSQL providers.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/challengearena?sslmode=require
UPLOAD_DIR=/data/uploads
